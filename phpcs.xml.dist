<?xml version="1.0"?>
<ruleset name="Multisite Network Email Manager">
	<description>Lint rules for plugin scaffold.</description>

	<file>multisite-network-email-manager.php</file>
	<file>includes</file>
	<file>uninstall.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>

	<rule ref="Generic.PHP.Syntax"/>
	<rule ref="Generic.Files.ByteOrderMark"/>
</ruleset>
